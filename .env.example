# Runtime configuration. Never commit real secrets to this file.
PORT="3000"

# Gemini API key used by the server-side AI assistant.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Authentication passwords must be provided through the deployment secret store.
SUPERADMIN_PASSWORD="CHANGE_ME"
DEFAULT_USER_PASSWORD="CHANGE_ME"

# Public application URL used for self-referential links and callbacks.
APP_URL="MY_APP_URL"
